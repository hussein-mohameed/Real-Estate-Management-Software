{
  "name": "compound-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "نظام إدارة المجمّع السكني — Single residential compound management. Arabic RTL. IQD.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "audit:completeness": "tsx scripts/completeness-audit.ts",
    "audit:money": "tsx scripts/money-naming-audit.ts",
    "verify": "npm run db:validate && npm run typecheck && npm run lint && npm run test && npm run audit:money && npm run audit:completeness",
    "db:constraints": "tsx scripts/apply-constraints.ts",
    "db:setup": "prisma migrate dev && npm run db:constraints && npm run seed",
    "env:check": "tsx scripts/env-check.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:password": "tsx scripts/set-db-password.ts",
    "db:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script -o prisma/sql/000-schema.sql",
    "db:test:setup": "tsx --env-file=.env.local scripts/setup-test-schema.ts && npm run db:test:sync",
    "db:test:sync": "tsx scripts/sync-test-schema.ts",
    "db:test:purge": "tsx --env-file=.env.test scripts/purge-test-data.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "erd": "tsx scripts/generate-erd.ts",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "check:google": "tsx scripts/check-google.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "seed:reset": "tsx prisma/seed.ts --reset"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-table": "^9.1.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
